---
import BaseLayout from './BaseLayout.astro';
import Logo from '../components/Logo.astro';

interface Props {
	title?: string;
	description?: string;
}

const { title, description } = Astro.props;

const nav = [
	{ label: 'Browse', href: '/browse' },
	{ label: 'How it works', href: '/how-it-works' },
	{ label: 'Pricing', href: '/pricing' },
];

const path = Astro.url.pathname;
const isActive = (href: string) => (href === '/' ? path === '/' : path.startsWith(href));
---

<BaseLayout title={title}>
	<header class="sticky top-0 z-50 border-b-2 border-ink bg-paper/90 backdrop-blur">
		<div class="mx-auto flex max-w-6xl items-center justify-between gap-4 px-5 py-3">
			<Logo />

			<nav class="hidden items-center gap-7 text-sm font-semibold md:flex">
				{
					nav.map(item => (
						<a
							href={item.href}
							class={`transition-colors hover:text-coral ${isActive(item.href) ? 'text-coral' : ''}`}
						>
							{item.label}
						</a>
					))
				}
			</nav>

			<div class="flex items-center gap-2.5">
				<a
					href="/cart"
					aria-label="Cart"
					class="sticker grid h-9 w-9 place-items-center rounded-full bg-white transition-all hover:-translate-y-0.5 active:translate-y-0.5 active:shadow-none"
				>
					<svg
						viewBox="0 0 24 24"
						class="h-5 w-5"
						fill="none"
						stroke="currentColor"
						stroke-width="2"
						stroke-linecap="round"
						stroke-linejoin="round"
						aria-hidden="true"
						><circle cx="9" cy="20" r="1.4"></circle><circle
							cx="18"
							cy="20"
							r="1.4"></circle><path d="M2 3h3l2.4 12h11L21 7H6"
						></path></svg
					>
				</a>
				<a href="/signin"> Sign in </a>
				<a href="/signup"> Start creating </a>
			</div>
		</div>
	</header>

	<main class="mx-auto max-w-5xl p-6">
		<slot />
	</main>
</BaseLayout>
